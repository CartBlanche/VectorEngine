<Project>
  <!-- One MonoGame version for the whole engine. Games must reference the same MonoGame.Framework.* version. -->
  <PropertyGroup>
    <MonoGameVersion>3.8.6.1</MonoGameVersion>
  </PropertyGroup>

  <!-- Version: 0.1.0-preview.N until the engine has shipped a game from the NuGet packages. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>CartBlanche</Authors>
    <Company>CartBlanche</Company>
    <Product>VectorEngine</Product>
    <Copyright>Copyright © 2026 CartBlanche</Copyright>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CartBlanche/VectorEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CartBlanche/VectorEngine.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>monogame;game-engine;vector-graphics;line-rendering;xna;neon</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-tile-128.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- On a CI build the paths in the symbols are rewritten so they work on any machine -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- the package icon: the opaque tile, since nuget.org shows it on white and the neon needs its dark square -->
    <None Include="$(MSBuildThisFileDirectory)branding\icon-tile-128.png" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404" PrivateAssets="All" />
  </ItemGroup>
</Project>
