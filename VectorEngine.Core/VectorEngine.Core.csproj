<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- a method that silently hides an inherited one is never called through the base class (this broke the waypoint actors once) -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0114;CS0108</WarningsAsErrors>
    <RootNamespace>VectorEngine</RootNamespace>
    <AssemblyName>VectorEngine.Core</AssemblyName>
    <AssemblyDescription>Shared vector game engine core</AssemblyDescription>
    <PackageId>VectorEngine.Core</PackageId>
    <Description>A small MonoGame engine for neon vector-line games: game base class, screens and menus, input and bindings, line rendering with bloom, audio, settings, localization, particles, world simulation and a start-up splash. Games reference their own MonoGame.Framework.* package at the same version.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time only: the game head supplies the real platform framework. No Net package here. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup Condition="'$(PerfOverlay)' == 'true'">
    <!-- dotnet build -c Release -p:PerfOverlay=true: puts the frame time / GC / draw call overlay in a Release build -->
    <DefineConstants>$(DefineConstants);PERF_OVERLAY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shipped in the package: the readme, and the engine's shaders with a .targets that adds them to the game's content build -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\Content\Engine.mgcb" Pack="true" PackagePath="build\" />
    <None Include="..\Content\Effects\*" Pack="true" PackagePath="build\Effects\" />
    <None Include="build\VectorEngine.Core.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VectorEngine.Tests" />
    <InternalsVisibleTo Include="VectorRumble.Tests" />
  </ItemGroup>
</Project>
